{
  "name": "kafka-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "test": "vitest run",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,less,css,js,jsx}\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "biome lint --write"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@navikt/ds-css": "8.11.0",
    "@navikt/ds-react": "8.6.0",
    "@navikt/ds-tokens": "8.11.0",
    "@navikt/fnrvalidator": "^2.2.1",
    "axios": "1.21.1",
    "classnames": "2.5.1",
    "constate": "^4.0.0",
    "dayjs": "1.11.23",
    "lodash.throttle": "4.1.1",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@microlink/react-json-view": "1.31.51",
    "react-toastify": "11.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/classnames": "2.3.4",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-modal": "3.16.3",
    "@vitejs/plugin-react": "6.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "msw": "3.0.7",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
