{
  "name": "kafka-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "test": "vitest run",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,less,css,js,jsx}\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "biome lint --write"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@navikt/ds-css": "^4.12.3",
    "@navikt/ds-react": "^4.12.1",
    "@navikt/ds-tokens": "^4.12.1",
    "@navikt/fnrvalidator": "^1.3.13",
    "axios": "^1.21.1",
    "classnames": "^2.5.1",
    "constate": "^3.3.3",
    "dayjs": "^1.11.23",
    "lodash.throttle": "^4.1.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@microlink/react-json-view": "^1.31.50",
    "react-toastify": "^7.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/classnames": "^2.3.4",
    "@types/jest": "^26.0.24",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^4.7.0",
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
    "msw": "^1.3.5",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vitest": "^0.33.0"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
